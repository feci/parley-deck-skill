{
  "primitive": {
    "$type": "color",
    "slate": { "$value": { "colorSpace": "srgb", "components": [0.106, 0.106, 0.106] } },
    "ink": { "$value": "{primitive.slate}" }
  },
  "semantic": {
    "$type": "color",
    "text": { "$value": "{primitive.slate}" },
    "border": { "$value": "{component.panel}" }
  },
  "component": {
    "$type": "color",
    "panel": { "$value": "{semantic.text}" }
  },
  "space": {
    "$type": "dimension",
    "gap": { "md": { "$value": "16px" } }
  }
}
