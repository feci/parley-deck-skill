{
  "primitive": {
    "$type": "dimension",
    "step": { "$value": "4px" }
  },
  "semantic": {
    "$type": "dimension",
    "small": { "$value": "{primitive.step}" },
    "medium": { "$value": "{semantic.small}" }
  },
  "component": {
    "$type": "dimension",
    "panel": { "$value": "{semantic.medium}" },
    "card": { "$value": "{component.panel}" }
  }
}
