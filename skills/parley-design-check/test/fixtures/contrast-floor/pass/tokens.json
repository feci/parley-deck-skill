{
  "$extensions": {
    "org.parley.pds": {
      "pairings": [
        { "text": "{color.text.muted}", "on": "{color.surface.raised}", "kind": "text" }
      ]
    }
  },
  "color": {
    "$type": "color",
    "text": {
      "muted": {
        "$value": { "colorSpace": "srgb", "components": [0.349, 0.349, 0.349], "hex": "#595959" }
      }
    },
    "surface": {
      "raised": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
      }
    }
  }
}
